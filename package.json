{
  "name": "dexsandro-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "react-scripts start",
    "dev": "react-scripts start",
    "build": "react-scripts build",
    "build:watch": "nodemon --watch src --ext js,jsx,css --exec \"npm run build\"",
    "serve": "npm run build && npx serve -s build -p 3000",
    "serve:watch": "nodemon --watch src --ext js,jsx,css --exec \"npm run serve\"",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.4",
    "react-scripts": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
